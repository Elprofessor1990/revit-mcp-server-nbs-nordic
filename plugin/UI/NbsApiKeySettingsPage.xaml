<Page x:Class="revit_mcp_plugin.UI.NbsApiKeySettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="Page_Loaded">
    <Grid Background="White">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,20,15">
                <TextBlock Text="Forbind NBS Nordic" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Indtast din NBS-nøgle, vælg et projekt, og forbind modellen. Din AI bruger samme opsætning."
                           TextWrapping="Wrap" Foreground="#555555" Margin="0,8,0,18"/>
                <Border Padding="14" Background="#F2F6FA" CornerRadius="4" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Text="Ikke forbundet" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ModelText" Text="Henter den aktive model…" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="NBS Nordic API-nøgle" FontWeight="SemiBold"/>
                <PasswordBox x:Name="ApiKeyPasswordBox" Padding="8" Margin="0,6,0,8" PasswordChanged="ApiKeyPasswordBox_PasswordChanged"/>
                <TextBlock Text="Nøglen giver adgang til dine NBS-projekter. En Anthropic-nøgle er kun til den valgfrie chat inde i Revit."
                           Foreground="#666666" TextWrapping="Wrap" FontSize="12"/>
                <TextBlock Text="Find min NBS-nøgle" Foreground="#1674BC" Cursor="Hand" TextDecorations="Underline"
                           MouseLeftButtonUp="WhereDoIFindMyApiKey_Click" Margin="0,8,0,12"/>
                <Button x:Name="LoadProjectsButton" Content="Forbind NBS og hent projekter" Click="LoadProjects_Click"
                        HorizontalAlignment="Left" Padding="14,8"/>
                <TextBlock Text="NBS-projekt til denne Revit-model" FontWeight="SemiBold" Margin="0,22,0,6"/>
                <ComboBox x:Name="ProjectsComboBox" DisplayMemberPath="Label" SelectedValuePath="Id"
                          SelectionChanged="Project_SelectionChanged" Padding="8" MinHeight="36"/>
                <TextBlock x:Name="ProjectDetailsText" TextWrapping="Wrap" Foreground="#666666" Margin="0,8,0,12"/>
                <Button x:Name="ConnectButton" Content="Forbind projekt og klargør NBS-felter" Click="Connect_Click"
                        IsEnabled="False" HorizontalAlignment="Left" Padding="16,9" Background="#1674BC" Foreground="White"/>
                <TextBlock Text="Projektkoblingen gemmes i modellen. NBS-felterne oprettes automatisk på typer og instanser. Gem RVT-filen bagefter."
                           TextWrapping="Wrap" FontSize="12" Foreground="#666666" Margin="0,10,0,18"/>

                <Border BorderBrush="#DDE3E9" BorderThickness="0,1,0,0" Margin="0,0,0,14"/>
                <TextBlock Text="Synkronisering for denne model" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Samme valg som i NBS Nordic's eget plugin. Din AI bruger disse som standard, når du beder den synkronisere; den kan stadig vælge anderledes for ét kald, hvis du beder om det."
                           TextWrapping="Wrap" Foreground="#555555" Margin="0,6,0,12"/>
                <TextBlock Text="Koblingstype" FontWeight="SemiBold"/>
                <StackPanel Margin="0,6,0,12">
                    <RadioButton x:Name="LinkTypeOnlyRadio" GroupName="LinkMode" Content="Type Only — skriv kun til typer" Margin="0,2"/>
                    <RadioButton x:Name="LinkInstanceOnlyRadio" GroupName="LinkMode" Content="Instance Only — skriv kun til instanser" Margin="0,2"/>
                    <RadioButton x:Name="LinkTypeAndInstanceRadio" GroupName="LinkMode" Content="Type and Instance — begge, hver med sin egen kobling" Margin="0,2"/>
                </StackPanel>
                <TextBlock Text="NBS-felter der må opdateres" FontWeight="SemiBold"/>
                <StackPanel Margin="0,6,0,8">
                    <CheckBox x:Name="FieldIdCheck" Content="NBS Component Id (anbefales — bruges til at genkende koblingen næste gang)" Margin="0,2"/>
                    <CheckBox x:Name="FieldCodeCheck" Content="NBS Classificationcode (fuld kode, fx [L]%AD.003)" Margin="0,2"/>
                    <CheckBox x:Name="FieldNameCheck" Content="NBS Component Name" Margin="0,2"/>
                    <CheckBox x:Name="FieldDateCheck" Content="NBS Date (skrives kun hvis tom eller ældre end bygningsdelens ændring i NBS; addin'ets Sync Now sætter sit eget tidsstempel)" Margin="0,2"/>
                    <CheckBox x:Name="FieldDocLinkCheck" Content="NBS Doc Link (publicerede beskrivelser)" Margin="0,2"/>
                </StackPanel>
                <TextBlock x:Name="NativeLinkTypeText" TextWrapping="Wrap" FontSize="12" Foreground="#666666" Margin="0,0,0,10"/>
                <Button x:Name="SaveSyncButton" Content="Gem synkroniseringsvalg for denne model" Click="SaveSync_Click"
                        IsEnabled="False" HorizontalAlignment="Left" Padding="14,8" Margin="0,0,0,18"/>

                <Expander Header="Opret et projekt fra en eksisterende skabelon">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="NBS API'et kan oprette en kopi af det valgte projekt og dets opsætning. Det kræver NBS' Pro-adgang. Kopien forbindes først, når du vælger Forbind projekt."
                                   TextWrapping="Wrap" Foreground="#666666"/>
                        <TextBox x:Name="CloneNameTextBox" Margin="0,8,0,8" Padding="8" ToolTip="Navn på det nye projekt"/>
                        <Button x:Name="CloneButton" Content="Opret kopi af valgt projekt" Click="Clone_Click" IsEnabled="False"
                                HorizontalAlignment="Left" Padding="12,7"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
