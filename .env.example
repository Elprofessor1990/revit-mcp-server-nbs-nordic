# NBS Nordic API integration
# Get your key from your NBS Nordic profile -> API-nøgle
# https://support.nbsnordic.dk/article/138-hvor-finder-jeg-min-api-kode
NBS_API_KEY=

# Optional default project ID — most nbs_* tools accept an explicit
# projectId and fall back to this when omitted.
NBS_PROJECT_ID=

# Base URL for the documented v2 endpoints. Default is fine unless NBS
# changes their API host.
NBS_BASE_URL=https://nbsnordic.net/api/v2

# Base URL for the v1 document endpoints. Inferred from the v2 convention,
# not independently verified — see server/src/integrations/nbs/NbsConfig.ts.
NBS_V1_BASE_URL=https://nbsnordic.net/api/v1
